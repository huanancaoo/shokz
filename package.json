{
  "name": "dtc-starter-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "poc:setup": "node scripts/poc.mjs setup",
    "poc:start": "node scripts/poc.mjs start",
    "poc:stop": "node scripts/poc.mjs stop",
    "poc:seed": "pnpm --dir apps/backend exec medusa exec ./src/scripts/seed-shokz.ts",
    "poc:verify": "node --env-file=apps/storefront/.env.local scripts/verify-commerce.mjs",
    "poc:capture": "python3 apps/backend/scripts/import-source.py",
    "poc:media": "pnpm --dir apps/backend exec medusa exec ./src/scripts/migrate-shokz-media.ts",
    "poc:verify-assets": "python3 apps/backend/scripts/verify-assets.py"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.7",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
